# Copie para .env e preencha. NUNCA versione o .env.

# --- CNES (credencial pública do manual de integração do Ministério da Saúde)
CNES_USUARIO=CNES.PUBLICO
CNES_SENHA=

# --- Supabase (destino principal)
# Pipeline: string de conexão do Postgres (Project Settings > Database >
# Connection string > Session pooler). Contém a SENHA do banco: é secreta.
SUPABASE_DB_URL=
# Fluxo do Typebot (typebot/gerar_typebot_supabase.py): URL do projeto e a
# chave PUBLICÁVEL (sb_publishable_... ou anon). Essa chave vai no fluxo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Google Sheets (opcional: cópia para a equipe consultar)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_ABA=
GOOGLE_APPLICATION_CREDENTIALS=credenciais_google.json

# --- Opcional
# Aviso de falha da atualização diária (ex.: https://hc-ping.com/<uuid> do healthchecks.io)
HEALTHCHECK_URL=
# Filtrar só alguns tipos de unidade (ex.: 01,02 = posto + UBS)
CNES_TIPOS_UNIDADE=
# Travas de segurança
PROPORCAO_MINIMA=0.8
MAX_PERCENT_ERROS=5
